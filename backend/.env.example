# --- Core ---
PORT=4000
# Generate with: openssl rand -hex 32
JWT_SECRET=
# Public base URL of this backend (used in email links)
APP_BASE_URL=http://localhost:4000

# --- Storage (defaults are fine for local dev) ---
# DATABASE_PATH=./data/app.db
# UPLOADS_DIR=./uploads

# --- Jotform ---
# jotform.com -> Settings -> API -> Create new key (Full Access)
JOTFORM_API_KEY=
JOTFORM_FORM_ID=261617924502052

# --- Email (reminders). Leave blank to run in simulated mode. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Receipts Bot <receipts@example.org>"
